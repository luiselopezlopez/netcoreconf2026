{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "demo: web",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\start-demo-web.ps1"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "functions: orquestador",
      "type": "shell",
      "command": "${workspaceFolder}\\.azure\\tools\\core-tools-4.16.0\\func.exe",
      "args": ["host", "start", "--port", "7071"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\orquestador",
        "env": {
          "PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}",
          "VIRTUAL_ENV": "${workspaceFolder}\\.venv",
          "languageWorkers__python__defaultExecutablePath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
          "FUNCTIONS_WORKER_RUNTIME": "python",
          "AzureWebJobsSecretStorageType": "Files",
          "languageWorkers__python__arguments": "-m debugpy --listen 127.0.0.1:9091"
        }
      },
      "isBackground": true,
      "problemMatcher": "$func-python-watch"
    }
  ]
}
